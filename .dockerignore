# Keep the build context small and the layer cache stable.
target/
.git/
.github/
.githooks/
.claude/
.claude-plugin/
viewer/
docs/
skills/
hooks/
ci/
packaging/
# The `lait` daemon image compiles the root lib, which `include_str!`s the
# systemd unit template; re-admit just that file (its parent, so both the
# classic and BuildKit ignore engines walk into it). The relay/post images
# never compile it, so they carried packaging/ fully excluded.
!packaging/linux/
!packaging/linux/lait.service.in
.lait/
.groupchat/
*.md
!README.md
# The license obligation an image carries: kept in context so both this and
# the Post seam image can COPY it.
!THIRD-PARTY-NOTICES.md
.dockerignore
