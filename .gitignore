target

# Local node state (per-repo space stores) — never commit.
.lait/
.groupchat/

# Web viewer (Vite) build + deps
viewer/node_modules/
viewer/dist/
*.tsbuildinfo
# Generated by Astrolabe's staging hook from immutable World sources.
apps/astrolabe-web/src-tauri/bundled-worlds/
# Local design history and working notes. Current product and protocol truth
# belongs in the lean tracked documentation set under docs/.
/docs/GUIDED-JOIN.md
/docs/HARDENING.md
/docs/ROADMAP.md
/docs/SCHEMA.md
/docs/RELEASE-SIGNING-RUNBOOK.local.md

# The coverage manifest check writes this beside the committed file so CI can
# upload it as an artifact; it is the ANSWER, never the record.
ci/coverage-manifest.txt.actual
THIRD-PARTY-NOTICES.md.actual
ci/coverage-manifest.txt.new

# proptest saves shrunk counterexamples here and they SHOULD be committed —
# but only when a real failure produced them, never a deliberate mutation.

# Flutter build output for the client.
apps/astrolabe/build/
apps/astrolabe/.dart_tool/
apps/astrolabe/windows/flutter/ephemeral/

# The local escape hatch from the pinned design-system commits. `pubspec.yaml`
# takes covalence and lit_ui from git at an exact ref so that a clean checkout
# — and CI — can build this application at all. Anyone working ON those
# packages wants their sibling checkout instead, and pub reads this file for
# exactly that.
#
# It stays out of the tree because committing it would put the relative paths
# back and undo the fix. Note that running `pub get` while it exists rewrites
# `pubspec.lock` to the path sources: that lock is local truth, not project
# truth, so restore it before committing.
apps/astrolabe/pubspec_overrides.yaml

# Local node state for a store rooted at the repo (the `orbital/` layout), the
# sibling of the `.lait/` rule above. A Space store is a person's data and a
# signing identity; it is never repository content.
/orbital/
/agents/
/daemon.lock
/daemon.pid

# Deprecated local scratch: plans live in lait, not in markdown (CLAUDE.md).
/docs/plans/

# Personal archives that happen to be unpacked in the working tree.
/takeout-*.zip

.DS_Store
