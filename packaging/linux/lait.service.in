# The unit `lait install` writes. `@ROOT@` and `@DISPLAY_LINE@` are filled in
# by `update::service::render_unit`; a `--user` install drops the four lines a
# user manager cannot honour. LAIT_SUPERVISED=1 is set here and nowhere else:
# under it a requested relaunch is a clean exit, and Restart= is the spawner.
[Unit]
Description=lait — an always-on device of its owner
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=lait
Group=lait
ExecStart=@ROOT@/bin/lait daemon
Environment=LAIT_CONFIG_ROOT=@ROOT@ HOME=@ROOT@ LAIT_SUPERVISED=1@DISPLAY_LINE@
Restart=always
RestartSec=2
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=yes
# The net plane's TUN and its routes. Ambient so the daemon holds it without
# being root — and ambient is exactly the set that survives execve, so the
# daemon clears it in every child it spawns (`disinherit_capabilities`) and
# leaves it only for the `ip` invocations that need it. The bounding set caps
# what may ever be gained here; it drops nothing on its own. A daemon without
# either line reports `interface: not permitted` and carries on — which is why
# a user-manager install, which cannot grant capabilities at all, simply drops
# them both.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ReadWritePaths=@ROOT@

[Install]
WantedBy=multi-user.target
