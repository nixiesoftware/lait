{
  "name": "lait-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "lait's web client — a keyboard-first board over the local control plane. Builds into src/serve/assets, which the lait binary embeds and serves.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node tool/generate-tokens.mjs",
    "tokens:check": "node tool/generate-tokens.mjs --check",
    "naming-gate": "node scripts/naming-gate.mjs",
    "tokens:astryx": "node tool/generate-astryx-theme.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.3.0",
    "@astryxdesign/theme-neutral": "^0.3.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@stylexjs/stylex": "^0.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.24.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.2",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  },
  "astryx": {
    "theme": "./src/theme/laitTheme.ts"
  }
}
