<?xml version="1.0" encoding="utf-8"?>
<!--
  The television is the signage system's one dark object: a screen panel.
  Tokens are the console's night set with the panel as the field.

    field   #171A1D   panel-screen        surface #1D2126
    ink     #F2F3F4   muted #A2A5A8       faint   #787B7E
    accent  #3B96F2   accent-ink #06121F
    positive #45D69E  miss #B8862B        alarm   #D8472E

  One family, two weights: Inter Regular and Medium (OFL, fonts/LICENSE-Inter.txt),
  the console's own fallback face. Sized for a room, not a desk: title 96,
  words 72, body 48, chip 40, label 32.

  Every node states a fact. Nothing restates what another node shows.
  Uppercase is for the pairing phrase only. Chips are pills; state is a
  dot in a pill. Chrome keeps to the 5% action-safe margin (96 x 54).
-->
<component name="AstrolabeScene" extends="Scene">
  <children>
    <Rectangle width="1920" height="1080" color="0x171A1DFF"/>
    <!-- The player sits beneath the still. A Video node paints black while it
         buffers and again the moment it stops; with the still above it, the
         still covers both edges and the cut lands on a picture each way. -->
    <Video id="programMedia" width="1920" height="1080" visible="false" enableUI="false"/>
    <!-- Two stills, double-buffered above the player. One shows what is on
         glass; the other decodes the next behind it, and they swap only once
         the next is verified — so nothing on the graphics plane is ever
         cleared before its replacement is ready, and the video plane never
         shows through as a black cut. Decoded at native size (noScale), so
         bitmapWidth/Height are the dimensions the authenticated metadata is
         checked against; each is scaled to the panel only after that passes. -->
    <Poster id="frameA" loadDisplayMode="noScale" visible="false"/>
    <Poster id="frameB" loadDisplayMode="noScale" visible="false"/>
    <!-- A signage panel is never idle. Roku has no switch for the OS screensaver
         on a still channel, so a hidden player loops two seconds of silence with
         the suppression flag set, and yields whenever real media plays. -->
    <Video id="keepAwake" visible="false" enableUI="false" disableScreenSaver="true" loop="true"/>

    <!-- Chrome: the mark and the name. Retires whole while a program is on
         glass, so the brand never sits on top of the picture. -->
    <Group id="chrome">
      <Group id="brand">
        <Poster uri="pkg:/images/icon.png" width="56" height="56" translation="[96,54]"/>
        <Label text="Astrolabe" translation="[168,54]" width="500" height="56" vertAlign="center" color="0xF2F3F4FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="44"/>
        </Label>
      </Group>
    </Group>

    <!-- The stage: the one fact a screen with nothing to show draws, center-glass. -->
    <Group id="stage">
      <Label id="title" translation="[160,170]" width="1600" height="130" horizAlign="center" vertAlign="top" wrap="true" color="0xF2F3F4FF">
        <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="96"/>
      </Label>
      <Label id="body" translation="[310,300]" width="1300" height="140" horizAlign="center" vertAlign="top" wrap="true" color="0xA2A5A8FF">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="48"/>
      </Label>

      <!-- Six words, uppercase: the one exception. -->
      <Group id="phraseGroup" translation="[148,330]" visible="false">
        <Poster uri="pkg:/images/card.9.png" width="520" height="150" translation="[0,0]" blendColor="0x1D2126FF"/>
        <Poster uri="pkg:/images/card.9.png" width="520" height="150" translation="[552,0]" blendColor="0x1D2126FF"/>
        <Poster uri="pkg:/images/card.9.png" width="520" height="150" translation="[1104,0]" blendColor="0x1D2126FF"/>
        <Poster uri="pkg:/images/card.9.png" width="520" height="150" translation="[0,174]" blendColor="0x1D2126FF"/>
        <Poster uri="pkg:/images/card.9.png" width="520" height="150" translation="[552,174]" blendColor="0x1D2126FF"/>
        <Poster uri="pkg:/images/card.9.png" width="520" height="150" translation="[1104,174]" blendColor="0x1D2126FF"/>
        <Label id="phrase0" translation="[0,0]" width="520" height="150" horizAlign="center" vertAlign="center" color="0xF2F3F4FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="72"/>
        </Label>
        <Label id="phrase1" translation="[552,0]" width="520" height="150" horizAlign="center" vertAlign="center" color="0xF2F3F4FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="72"/>
        </Label>
        <Label id="phrase2" translation="[1104,0]" width="520" height="150" horizAlign="center" vertAlign="center" color="0xF2F3F4FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="72"/>
        </Label>
        <Label id="phrase3" translation="[0,174]" width="520" height="150" horizAlign="center" vertAlign="center" color="0xF2F3F4FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="72"/>
        </Label>
        <Label id="phrase4" translation="[552,174]" width="520" height="150" horizAlign="center" vertAlign="center" color="0xF2F3F4FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="72"/>
        </Label>
        <Label id="phrase5" translation="[1104,174]" width="520" height="150" horizAlign="center" vertAlign="center" color="0xF2F3F4FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="72"/>
        </Label>
      </Group>

      <!-- A readout: label over value. -->
      <Group id="readout" translation="[160,700]" visible="false">
        <Label id="readoutLabel" translation="[0,0]" width="1600" height="40" horizAlign="center" vertAlign="center" color="0x787B7EFF">
          <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="32"/>
        </Label>
        <Label id="readoutValue" translation="[0,44]" width="1600" height="120" horizAlign="center" vertAlign="top" wrap="true" color="0xF2F3F4FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="44"/>
        </Label>
      </Group>

      <!-- The one act on this surface wears the accent and names its key. -->
      <Group id="action" translation="[760,860]" visible="false">
        <Poster id="actionPill" uri="pkg:/images/pill.9.png" width="400" height="80" blendColor="0x3B96F2FF"/>
        <Group id="actionKey" translation="[16,16]">
          <Poster uri="pkg:/images/pill.9.png" width="84" height="48" blendColor="0x06121FFF" opacity="0.18"/>
          <Label text="OK" translation="[0,0]" width="84" height="48" horizAlign="center" vertAlign="center" color="0x06121FFF">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="32"/>
          </Label>
        </Group>
        <Label id="actionLabel" translation="[116,0]" height="80" vertAlign="center" color="0x06121FFF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="40"/>
        </Label>
      </Group>
    </Group>

    <!-- Info: the receiver's facts, in a card at the panel's edge. -->
    <Group id="details" translation="[1224,800]" visible="false">
      <Poster uri="pkg:/images/card.9.png" width="600" height="226" blendColor="0x1D2126FF"/>
      <Label text="Source" translation="[32,28]" width="170" height="52" vertAlign="center" color="0x787B7EFF">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="32"/>
      </Label>
      <Label id="detailSource" translation="[208,28]" width="360" height="52" vertAlign="center" color="0xF2F3F4FF">
        <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="40"/>
      </Label>
      <Label text="Delivery" translation="[32,88]" width="170" height="52" vertAlign="center" color="0x787B7EFF">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="32"/>
      </Label>
      <Label id="detailDelivery" translation="[208,88]" width="360" height="52" vertAlign="center" color="0xF2F3F4FF">
        <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="40"/>
      </Label>
      <Label text="Protocol" translation="[32,148]" width="170" height="52" vertAlign="center" color="0x787B7EFF">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="32"/>
      </Label>
      <Label text="Astrolabe Display 1" translation="[208,148]" width="360" height="52" vertAlign="center" color="0xF2F3F4FF">
        <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="40"/>
      </Label>
    </Group>

    <!-- Liveness HUD: its own top layer, above the program, so it can flash a
         state change over a playing picture and retire on its own without the
         brand chrome. Hidden whenever the screen is healthy. -->
    <Group id="statusChip" translation="[1424,44]" visible="false">
      <Poster id="statusPill" uri="pkg:/images/pill.9.png" width="400" height="76" blendColor="0x1D2126FF"/>
      <Poster id="statusDot" uri="pkg:/images/dot.png" width="20" height="20" translation="[28,28]" blendColor="0x787B7EFF"/>
      <Label id="statusLabel" text="Connecting…" translation="[64,0]" height="76" vertAlign="center" color="0xF2F3F4FF">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="40"/>
      </Label>
    </Group>

    <!-- The player is stopped a beat after it has been covered, off the cut. -->
    <Timer id="mediaStop" duration="4" repeat="false"/>
    <!-- The outgoing still is hidden a frame after the incoming one is shown,
         so the swap never leaves a tick with neither on the graphics plane. -->
    <Timer id="posterRetire" duration="0.2" repeat="false"/>
    <!-- A liveness change announces itself, then the chip retires so it never
         burns into the glass. Healthy shows nothing at all. -->
    <Timer id="statusHud" duration="6" repeat="false"/>

    <!-- What is on glass right now breathes. It is the only motion. -->
    <Animation id="breathe" duration="2.4" repeat="true" easeFunction="inOutQuadratic">
      <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[1.0, 0.35, 1.0]" fieldToInterp="statusDot.opacity"/>
    </Animation>

    <AstrolabeReceiverTask id="receiverTask"/>
  </children>
  <script type="text/brightscript" uri="pkg:/components/AstrolabeScene.brs"/>
</component>
