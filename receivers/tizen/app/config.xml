<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://nixiesoftware.com/astrolabe"
        version="0.1.0"
        viewmodes="maximized">
  <tizen:application id="NixieAstro.Astrolabe" package="NixieAstro" required_version="5.5"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>Astrolabe</name>
  <access origin="https://nixiesoftware.com" subdomains="false"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="enable"
                 install-location="auto"
                 hwkey-event="enable"
                 pointing-device-support="disable"/>
</widget>
