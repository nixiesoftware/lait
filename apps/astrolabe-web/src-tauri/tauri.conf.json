{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astrolabe",
  "version": "0.1.0",
  "identifier": "dev.lait.astrolabe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Astrolabe",
        "width": 640,
        "height": 720,
        "resizable": true,
        "maximizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../astrolabe/macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_1024.png"]
  }
}
