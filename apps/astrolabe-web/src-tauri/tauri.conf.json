{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astrolabe",
  "mainBinaryName": "astrolabe",
  "version": "0.1.0",
  "identifier": "dev.lait.astrolabe",
  "build": {
    "beforeDevCommand": "npm run stage-sidecar && npm run dev",
    "beforeBuildCommand": "npm run stage-bundle && npm run build",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Astrolabe",
        "width": 640,
        "height": 720,
        "resizable": true,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "externalBin": ["binaries/lait"],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "world-catalog/": "world-catalog/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
