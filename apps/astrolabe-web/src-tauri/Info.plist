<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the bundle's generated Info.plist. Registers the `lait:` scheme
  so the OS delivers invites and raises here; without it a `lait://` link has
  nowhere to go and following one does nothing at all.
-->
<plist version="1.0">
<dict>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>dev.lait.astrolabe.link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>lait</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
