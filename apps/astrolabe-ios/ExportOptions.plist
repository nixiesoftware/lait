<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and App Store go through the same door. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>HXT63ZDAAW</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Upload directly rather than exporting an .ipa to disk; the archive
	     itself remains the local artifact of record. -->
	<key>destination</key>
	<string>upload</string>
</dict>
</plist>
